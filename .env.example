# ---------------------------------------------------------------------------
# Sift — environment configuration (placeholders only; never commit secrets)
# Copy to .env and fill in real values for your environment.
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
# Public base URL of the web app
WEB_BASE_URL=http://localhost:3000
# Public base URL of the API (browser -> api). In dev the web app proxies.
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Authentication -----------------------------------------------------
# Secret used to sign session tokens. Placeholder — replace in real envs.
AUTH_SECRET=dev_auth_secret_change_me
SESSION_COOKIE_NAME=sift_session
SESSION_TTL_HOURS=168

# Google OAuth (placeholder values; leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database -----------------------------------------------------------
# Local-first default is SQLite (zero infrastructure).
DATABASE_URL=file:./dev.db
# Production (PostgreSQL): set DB_PROVIDER=postgresql and a Postgres URL, e.g.
# DATABASE_URL=postgresql://sift:sift@localhost:5432/sift
DB_PROVIDER=sqlite

# --- Queue --------------------------------------------------------------
# "memory" runs an in-process queue (zero infrastructure).
# "redis" uses BullMQ + Redis.
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# --- LLM provider (placeholder) ----------------------------------------
LLM_PROVIDER=placeholder
LLM_PROVIDER_KEY=
LLM_DEFAULT_MODEL=placeholder-reasoning
LLM_FAST_MODEL=placeholder-fast

# --- Search provider (placeholder) -------------------------------------
SEARCH_PROVIDER=placeholder
SEARCH_PROVIDER_KEY=

# --- Storage (S3-compatible; placeholder) ------------------------------
STORAGE_DRIVER=local
STORAGE_BUCKET=sift-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# --- Billing (Stripe; placeholder) -------------------------------------
BILLING_PROVIDER=placeholder
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONE_TIME=
STRIPE_PRICE_PRO=

# --- Entitlements -------------------------------------------------------
FREE_ANALYSES_PER_ACCOUNT=2

# --- Observability ------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# --- Feature flags ------------------------------------------------------
FF_CHALLENGE_MODE=true
FF_EXPERIMENT_WORKSPACE=true
FF_PDF_EXPORT=true
FF_GOOGLE_AUTH=false
FF_BILLING=true
FF_COLLABORATION=false
FF_ADVANCED_RESEARCH=false
